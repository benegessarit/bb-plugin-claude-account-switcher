{
  "name": "bb-plugin-claude-account-switcher",
  "version": "0.1.0",
  "description": "Switch the machine-wide Claude subscription used by one BB Claude Code session without restarting BB.",
  "author": {
    "name": "David Beyer",
    "url": "https://github.com/benegessarit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benegessarit/bb-plugin-claude-account-switcher.git"
  },
  "homepage": "https://github.com/benegessarit/bb-plugin-claude-account-switcher#readme",
  "bugs": {
    "url": "https://github.com/benegessarit/bb-plugin-claude-account-switcher/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "bb-plugin",
    "claude-code",
    "account-switching"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.11"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bb": {
    "name": "Claude Account Switcher",
    "description": "Rebind one BB Claude Code session to the verified subscription login on its machine.",
    "branding": {
      "icon": "UserSwitch"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "check": "npm run format:check && npm run typecheck && npm test && bb plugin types --check . && npm pack --dry-run",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "prepack": "npm run build",
    "test": "bb plugin build && node --test --test-timeout=15000 tests/*.test.ts && vitest run tests/app.test.tsx tests/app-bundle.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.11",
    "@radix-ui/react-dialog": "^1.1.19",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "bb-app": "0.39.0",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
